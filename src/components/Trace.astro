---
// A career timeline drawn like a GPU profiler trace: one lane per stream of
// work, spans placed on a shared time axis, and a zoom to a narrower window.
import { getCollection } from 'astro:content';
import { traceSpans } from '../data/site';

const idx = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return (y - 2022) * 12 + (m - 1);
};

const now = new Date();
const nowIdx = (now.getFullYear() - 2022) * 12 + now.getMonth();

const views = {
  full: { label: '2022 to 2027', start: idx('2022-01'), end: idx('2027-07') },
  zoom: { label: 'Spring 2026', start: idx('2025-12'), end: idx('2026-06') },
};

type Span = { label: string; detail: string; s: number; e: number; href: string; kind: string; row: number };

const work: Span[] = [];
const study: Span[] = [];
for (const t of traceSpans) {
  const s = idx(t.start);
  const e = idx(t.end) + 1;
  const base = { label: t.label, detail: t.detail, href: t.href, row: 0 };
  const target = t.lane === 'work' ? work : study;
  if (s < nowIdx && e > nowIdx) {
    target.push({ ...base, s, e: nowIdx, kind: t.lane });
    target.push({ ...base, label: '', detail: t.detail, s: nowIdx, e, kind: `${t.lane} future` });
  } else {
    target.push({ ...base, s, e, kind: t.lane });
  }
}

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => idx(a.data.start) - idx(b.data.start));
const rowsEnd: number[] = [];
const proj: Span[] = projects.map((p) => {
  const s = idx(p.data.start);
  const e = idx(p.data.end) + 1;
  let row = rowsEnd.findIndex((end) => end <= s);
  if (row === -1) { row = rowsEnd.length; rowsEnd.push(e); } else rowsEnd[row] = e;
  return {
    label: p.data.short,
    detail: `${p.data.title}, ${p.data.period}`,
    href: `/projects/${p.id}`,
    s, e, row, kind: 'project',
  };
});
const projRows = Math.max(1, rowsEnd.length);

const years = [2022, 2023, 2024, 2025, 2026, 2027].map((y) => ({ text: String(y), at: (y - 2022) * 12, view: 'full' }));
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const months = [];
for (let i = views.zoom.start; i < views.zoom.end; i++) {
  months.push({ text: monthNames[((i % 12) + 12) % 12], at: i, view: 'zoom' });
}
const ticks = [...years, ...months];

const lanes = [
  { name: 'Work', spans: work, rows: 1 },
  { name: 'Study', spans: study, rows: 1 },
  { name: 'Projects', spans: proj, rows: projRows },
];
---
<div class="trace" data-view="full" style={`--f0:${views.full.start};--flen:${views.full.end - views.full.start};--z0:${views.zoom.start};--zlen:${views.zoom.end - views.zoom.start};--now:${nowIdx}`}>
  <div class="trace-bar">
    <p class="readout" aria-live="polite" data-default="Now in my second year at NYU, graduating May 2027.">Now in my second year at NYU, graduating May 2027.</p>
    <div class="zoom" role="group" aria-label="Timeline range">
      <button type="button" data-set="full" aria-pressed="true">{views.full.label}</button>
      <button type="button" data-set="zoom" aria-pressed="false">{views.zoom.label}</button>
    </div>
  </div>
  <div class="trace-grid" role="group" aria-label="Career timeline">
    {lanes.map((lane) => (
      <>
        <div class="lane-name">{lane.name}</div>
        <div class="track" style={`--rows:${lane.rows}`}>
          {lane.spans.map((sp) => (
            <a
              class={`span ${sp.kind}`}
              href={sp.href}
              style={`--s:${sp.s};--e:${sp.e};--row:${sp.row}`}
              data-detail={sp.detail}
              aria-label={sp.detail}
            >
              <span class="span-label">{sp.label}</span>
            </a>
          ))}
          <span class="now-line" aria-hidden="true"></span>
        </div>
      </>
    ))}
    <div></div>
    <div class="axis" aria-hidden="true">
      {ticks.map((t) => (
        <span class="tick" data-for={t.view} style={`--at:${t.at}`}>{t.text}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .trace {
    --row-h: 1.75rem;
    --gap: 0.375rem;
    --v0: var(--f0);
    --vlen: var(--flen);
    margin-top: 3rem;
    padding: 1.25rem 1.25rem 1rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .trace[data-view='zoom'] { --v0: var(--z0); --vlen: var(--zlen); }

  .trace-bar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 0.75rem 1.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;
  }
  .readout { margin: 0; min-height: 1.6em; }

  .zoom { display: inline-flex; border: 1px solid var(--rule); border-radius: 6px; overflow: hidden; }
  .zoom button {
    font: inherit; font-size: 0.875rem; color: var(--muted); background: transparent;
    border: 0; padding: 0.3rem 0.75rem; cursor: pointer;
  }
  .zoom button + button { border-left: 1px solid var(--rule); }
  .zoom button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .zoom button:focus-visible { outline-offset: -3px; }

  .trace-grid { display: grid; grid-template-columns: 4.75rem 1fr; row-gap: 0.625rem; align-items: start; }
  .lane-name { color: var(--muted); font-size: 0.875rem; line-height: var(--row-h); }

  .track {
    position: relative;
    height: calc(var(--rows) * var(--row-h) + (var(--rows) - 1) * var(--gap));
    background: var(--bg);
    border-radius: 5px;
    overflow: hidden;
  }

  .span {
    position: absolute;
    top: calc(var(--row) * (var(--row-h) + var(--gap)));
    height: var(--row-h);
    left: calc((var(--s) - var(--v0)) / var(--vlen) * 100%);
    width: calc((var(--e) - var(--s)) / var(--vlen) * 100%);
    border-radius: 4px;
    color: var(--span-ink);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: var(--row-h);
    container-type: inline-size;
    overflow: hidden;
    transition: left 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .span.work { background: var(--work); }
  .span.study { background: var(--study); }
  .span.project { background: var(--project); color: #1d1405; }
  .span.future { background: var(--future); box-shadow: inset 0 0 0 1px var(--study); }
  .span:hover, .span:focus-visible { filter: brightness(1.12); z-index: 2; }
  .span:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }

  .span-label {
    display: block;
    padding-right: 0.5rem;
    /* Keep the label visible when the span starts before the visible range. */
    padding-left: max(0.5rem, calc((var(--v0) - var(--s)) / (var(--e) - var(--s)) * 100cqw + 0.5rem));
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  @container (max-width: 3.5rem) {
    .span-label { display: none; }
  }

  .now-line {
    position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px;
    left: calc((var(--now) - var(--v0)) / var(--vlen) * 100%);
    background: var(--ink);
    transition: left 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .axis { position: relative; height: 1.5rem; }
  .tick {
    position: absolute; top: 0.25rem;
    left: calc((var(--at) - var(--v0)) / var(--vlen) * 100%);
    font-size: 0.8125rem; color: var(--muted);
    font-feature-settings: 'tnum' 1;
    padding-left: 0.25rem;
    border-left: 1px solid var(--rule);
    line-height: 1.2;
  }
  .trace[data-view='full'] .tick[data-for='zoom'],
  .trace[data-view='zoom'] .tick[data-for='full'] { display: none; }

  @media (max-width: 40rem) {
    .trace { padding: 1rem 0.875rem 0.75rem; margin-inline: -0.25rem; }
    .trace-grid { grid-template-columns: 1fr; row-gap: 0.25rem; }
    .lane-name { line-height: 1.4; margin-top: 0.5rem; }
    .trace-grid > div:empty { display: none; }
  }
</style>

<script define:vars={{ z0: views.zoom.start, zlen: views.zoom.end - views.zoom.start, full: views.full }}>
  const trace = document.querySelector('.trace');
  if (trace) {
    // Keep the "now" marker correct between deploys.
    const d = new Date();
    trace.style.setProperty('--now', (d.getFullYear() - 2022) * 12 + d.getMonth());

    const readout = trace.querySelector('.readout');
    const fallback = readout.dataset.default;
    const spans = [...trace.querySelectorAll('.span')];

    const show = (text) => { readout.textContent = text; };
    spans.forEach((sp) => {
      sp.addEventListener('mouseenter', () => show(sp.dataset.detail));
      sp.addEventListener('focus', () => show(sp.dataset.detail));
      sp.addEventListener('mouseleave', () => show(fallback));
      sp.addEventListener('blur', () => show(fallback));
    });

    // Spans scrolled out of the current range should not be tabbable.
    const syncTabStops = (view) => {
      const start = view === 'zoom' ? z0 : full.start;
      const end = view === 'zoom' ? z0 + zlen : full.end;
      spans.forEach((sp) => {
        const s = Number(sp.style.getPropertyValue('--s'));
        const e = Number(sp.style.getPropertyValue('--e'));
        const visible = e > start && s < end;
        sp.tabIndex = visible ? 0 : -1;
        sp.setAttribute('aria-hidden', visible ? 'false' : 'true');
      });
    };

    const buttons = [...trace.querySelectorAll('.zoom button')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        trace.dataset.view = b.dataset.set;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        syncTabStops(b.dataset.set);
      })
    );
    syncTabStops('full');
  }
</script>
