---
import type { CollectionEntry } from 'astro:content';
import Title from './Title.astro';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<ol class="projects">
  {projects.map((p, i) => (
    <li>
      <a class="project" href={`/projects/${p.id}`}>
        <span class="num" aria-hidden="true">{pad(i + 1)}</span>
        <h3><Title text={p.data.title} /></h3>
        <span class="when">{p.data.period}</span>
        <div class="body">
          <p class="summary">{p.data.summary}</p>
          <p class="stack mono">{p.data.stack.join(' · ')}</p>
          <span class="more">View project <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    </li>
  ))}
</ol>
