---
import Base from '../layouts/Base.astro';
import Scopes from '../components/Scopes.astro';
import Logo from '../components/Logo.astro';
import { skillGroups, toolGroups, site } from '../data/site';
import Chips from '../components/Chips.astro';
import { toolIcons } from '../data/toolIcons';

const areas = [
  {
    title: 'Debt collection platform',
    body: 'Feature work across the product, including debt collection management and the Performance Management Platform, one important module that scores debt-collection performance across 10M+ loan accounts (18 REST APIs and 2 batch pipelines within that module).',
  },
  {
    title: 'Reusable platform services',
    body: 'Three services used across the product: access management modeled on IAM (about 50 APIs, JWT and RBAC), multi-channel notifications (email, SMS, WhatsApp, push), and multi-level approval workflows driven by configurable business rules.',
  },
  {
    title: 'Backend, data, and events',
    body: 'Node.js and Express microservices, nearly 200 REST APIs plus GraphQL, database design and optimization on MongoDB, Redis caching, batch pipelines, and event-driven integrations with Kafka and RabbitMQ, on AWS.',
  },
  {
    title: 'Clients and delivery',
    body: 'Technical design discussions with enterprise financial institution clients, turning their requirements into system designs, then owning releases, reviewing PRs, and mentoring junior engineers.',
  },
  {
    title: 'AI features',
    body: 'AI-powered features, including an LLM-powered workflow generator built on RAG, which won the internal AI hackathon in May 2025.',
  },
];
---
<Base title="Experience" description="Three years at Ezee.ai designing, coding, and shipping production backend systems for debt collection software, from intern to member of technical staff.">
  <div class="wrap">
    <header class="page-head">
      <h1>Experience</h1>
      <p class="lede">
        Three years at Ezee.ai building production backend systems for debt collection software:
        designing features, writing and reviewing the code, owning modules, and working directly with
        clients. I started as an intern and stayed on full time.
      </p>
    </header>

    <section class="section" aria-labelledby="work-h">
      <div class="section-label">
        <h2 id="work-h">Work</h2>
      </div>
      <div class="section-body">
        <article class="entry wide">
          <div>
            <div class="org">
              <Logo name="ezee" alt="" />
              <h3>Ezee.ai</h3>
            </div>
            <p class="role-line">Debt collection software for financial institutions. Chennai, India.</p>

            <div class="role-head" id="full-time">
              <h4>Member of technical staff</h4>
              <span class="role-type">Full time</span>
              <span class="role-dates">Jun 2022 – Jul 2025</span>
            </div>
            <p class="summary-lede">
              I designed, coded, and shipped across a large part of the product: feature development,
              backend architecture, APIs and microservices, databases and caching, event-driven
              systems, enterprise features, releases, and production debugging. Over time that grew
              into system design, client-facing technical discussions, mentoring, and AI features.
            </p>

            <Scopes />

            <div class="areas">
              {areas.map((a) => (
                <section class="area">
                  <h4>{a.title}</h4>
                  <p>{a.body}</p>
                </section>
              ))}
            </div>

            <section class="story" id="pipeline" aria-labelledby="pipeline-h">
              <p class="story-kicker">System and performance engineering</p>
              <h4 id="pipeline-h">Taking a two-year-old bottleneck from 180 minutes to 20</h4>
              <figure class="runtime" aria-label="Batch pipeline runtime before and after: 180 minutes to 20 minutes">
                <div class="bar-row"><span class="bar-label">Before</span><span class="bar"><span style="width:100%"></span></span><span class="bar-val">180 min</span></div>
                <div class="bar-row"><span class="bar-label">After</span><span class="bar"><span style="width:11.1%"></span></span><span class="bar-val">20 min</span></div>
              </figure>
              <p>
                A mission-critical batch pipeline in the Performance Management Platform had been a
                known performance problem for over two years. I took ownership of it.
              </p>
              <p>
                I started by understanding the existing system end to end: what the pipeline read,
                how it moved data, and the access patterns behind each step. That made the
                bottlenecks clear. I then redesigned parts of the processing pipeline and changed how
                it worked with data: tuned the MongoDB aggregations, added compound indexes that
                matched the real access patterns, used field projection so the pipeline only
                fetched what it needed, cached with Redis, and replaced per-record writes with bulk
                writes.
              </p>
              <p>I measured the result: runtime dropped from 180 minutes to 20, a 9× improvement.</p>
            </section>

            <section class="story" id="incident" aria-labelledby="incident-h">
              <p class="story-kicker">Production</p>
              <h4 id="incident-h">Recovering a deleted collection</h4>
              <p>
                A live MongoDB collection was accidentally deleted. I reconstructed the data from
                logs and dependent collections within about 10 hours and restored the client.
              </p>
              <p>
                Afterwards I helped establish the company's backup and recovery standard. It was one
                of the 30+ production incidents I resolved there.
              </p>
            </section>

            <div class="role-head intern" id="intern">
              <h4>Backend development intern</h4>
              <span class="role-type">Internship</span>
              <span class="role-dates">Feb 2022 – May 2022</span>
            </div>
            <p class="intern-text">
              I built a reusable backend component library and a generic API versioning framework that
              later features were built on, cutting development effort by 50%.
            </p>

            <p class="pointer">
              Awards from my time at Ezee.ai, including the Innovation Instigator Award and the AI
              hackathon win, are on <a class="text-link" href="/achievements">Achievements</a>.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-h">
      <div class="section-label">
        <h2 id="skills-h">Skills</h2>
        <p class="note">What I work with.</p>
      </div>
      <div class="section-body">
        <Chips groups={skillGroups} />
      </div>
    </section>

    <section class="section" id="tools" aria-labelledby="tools-h">
      <div class="section-label">
        <h2 id="tools-h">Tools</h2>
        <p class="note">What my day-to-day workflow runs on.</p>
      </div>
      <div class="section-body">
        <div class="tool-groups">
          {toolGroups.map((g) => (
            <div class="tool-group">
              <h3 class="tool-group-name">{g.group}</h3>
              <ul class="tools">
                {g.tools.map((t) => (
                  <li>
                    <span class="tool-icon" set:html={toolIcons[t.icon]} />
                    <span class="tool-text">
                      <span class="tool-name">{t.name}</span>
                      <span class="tool-what">{t.what}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="tool-credit muted">Icons from Simple Icons, Devicon, and Lucide.</p>
        <p class="resume-line"><a class="u always" href={site.resume}>Download resume (PDF) <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </div>
</Base>

<style>
  .summary-lede { font-family: var(--serif); font-size: clamp(1.1875rem, 1.1rem + 0.3vw, 1.3125rem); line-height: 1.5; max-width: 38rem; }

  .areas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2.5rem; margin: 2.5rem 0 1rem; }
  .area h4 { margin: 0 0 0.4rem; font-size: 0.9375rem; font-weight: 600; }
  .area p { margin: 0; font-size: 0.9375rem; color: var(--ink); }

  .story { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); max-width: 38rem; }
  .story-kicker { font-family: var(--serif); font-style: italic; color: var(--muted); margin: 0 0 0.35rem; }
  .story h4 { text-wrap: balance; font-family: var(--serif); font-weight: 400; font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem); line-height: 1.25; margin: 0 0 1.25rem; }

  .runtime { margin: 0 0 1.5rem; display: grid; gap: 0.5rem; }
  .bar-row { display: grid; grid-template-columns: 3.75rem minmax(0, 1fr) 4.25rem; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
  .bar-label { color: var(--muted); }
  .bar { height: 0.625rem; background: var(--panel); border-radius: 2px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--ink); }
  .bar-row:last-child .bar span { background: var(--accent); }
  .bar-val { font-variant-numeric: tabular-nums; text-align: right; }

  .role-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin: 2rem 0 1rem; padding-top: 1.25rem; border-top: 2px solid var(--ink); }
  .role-head h4 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem); flex: 1 1 auto; }
  .role-type { font-size: 0.8125rem; color: var(--accent); border: 1px solid var(--rule); border-radius: 4px; padding: 0.1rem 0.5rem; }
  .role-dates { color: var(--muted); font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
  .role-head.intern { margin-top: 4rem; }
  .intern-text { max-width: 38rem; }
  .pointer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); font-size: 0.9375rem; max-width: 38rem; }
  .tool-group + .tool-group { margin-top: 2rem; }
  .tool-group-name { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 1.0625rem; color: var(--muted); margin: 0 0 0.4rem; }
  .tools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  .tools li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 0.75rem; align-items: start; padding: 0.75rem 0; border-top: 1px solid var(--rule); }
  .tool-icon { display: flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; color: var(--ink); opacity: 0.8; }
  .tool-icon :global(svg) { width: 100%; height: 100%; }
  .tool-text { display: grid; gap: 0.1rem; }
  .tool-credit { font-size: 0.75rem; margin-top: 1.25rem; }
  .tool-name { font-weight: 500; font-size: 0.9375rem; }
  .tool-what { color: var(--muted); font-size: 0.875rem; line-height: 1.45; }

  .resume-line { margin-top: 2rem; }

  @media (max-width: 46rem) {
    .areas { grid-template-columns: minmax(0, 1fr); }
    .tools { grid-template-columns: minmax(0, 1fr); }
  }
</style>
