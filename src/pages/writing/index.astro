---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Writing" description="Technical notes on systems, GPUs, and AI.">
  <div class="wrap">
    <section class="intro">
      <h1>Writing</h1>
      <p>Notes on things I've built or studied.</p>
    </section>
    <section>
      {posts.length === 0 ? (
        <p class="muted">No posts published yet.</p>
      ) : (
        <ul class="project-list">
          {posts.map((p) => (
            <li>
              <a class="project-row" href={`/writing/${p.id}`}>
                <h3>{p.data.title}</h3>
                <span class="when">{fmt(p.data.date)}</span>
                <p class="summary">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>
