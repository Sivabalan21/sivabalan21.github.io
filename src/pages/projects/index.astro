---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Case studies: an AI clinical platform, a distributed recommendation system, FlashAttention-3 kernels on H100, and LLM reasoning from scratch.">
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">Write-ups of what I built, how it works, and what came out of it.</p>
    </header>
    <section class="section" aria-label="All projects">
      <div class="section-label"><p class="note">{projects.length} projects, 2026.</p></div>
      <div class="section-body"><ProjectList projects={projects} /></div>
    </section>
  </div>
</Base>
